APP_NAME=UEL RAG Chatbot PoC
APP_ENV=development
# Chat header X-API-Key. Dùng khi API_CLIENTS rỗng: một key = APP_DEPARTMENT_ID + APP_MODULE_CODE.
APP_API_KEY=replace-with-a-long-random-value
# Admin header X-Admin-Key (nạp Excel, /admin). Nên khác APP_API_KEY. Dev/test: X-Admin-Key cũng nhận APP_API_KEY.
APP_ADMIN_API_KEY=replace-with-a-separate-admin-key
APP_DEPARTMENT_ID=bao_dam_chat_luong
APP_MODULE_CODE=khao_khi
DEPARTMENTS_CONFIG_PATH=configs/departments.yaml

# Nhiều tenant: JSON một dòng. Mỗi api_key một department_id + modules[].
# Khi list này không rỗng, APP_API_KEY không còn dùng cho chat.
# API_CLIENTS=[{"id":"bdcl-service","department_id":"bao_dam_chat_luong","modules":["khao_khi"],"api_key":"replace-with-a-16-char-secret"}]
API_CLIENTS=[]

CORS_ORIGINS=[]
CHAT_TIMEOUT_SECONDS=90
ADMIN_TIMEOUT_SECONDS=600
REQUEST_MAX_BYTES=16384
SOURCE_UPLOAD_MAX_BYTES=16777216

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
READINESS_TIMEOUT_SECONDS=3.0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=uel_rag
POSTGRES_USER=uel
POSTGRES_PASSWORD=replace-with-a-strong-password

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=uel_knowledge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=2
EMBEDDING_MAX_LENGTH=512
GOLD_FAQ_SCORE_BOOST=0.12
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.4167
RAG_SEARCH_MODE=hybrid

LLM_PROVIDER=fake
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-minio-secret-key
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_ATTACHMENTS=attachments
